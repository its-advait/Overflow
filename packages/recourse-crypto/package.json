    "cli": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@overflow/schemas": "workspace:*",
    "viem": "^2.57.10",
    "zod": "^4.6.7"
  }
}

{
  "name": "@overflow/overflow-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "stdio MCP server: overflow_budget, overflow_quote and overflow_pay let any agent pay x402 APIs under an Overflow node's policy; every payment settles only through OverflowTreasury.settle()",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "overflow-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.60.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@overflow/payment-client": "workspace:*",
    "@overflow/schemas": "workspace:*",
    "viem": "^2.57.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}

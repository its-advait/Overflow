{
  "name": "@overflow/payment-client",
  "version": "0.0.0",
  "private": true,
  "description": "x402 client: parses 402 quotes, checks them against the PurchaseOrder, and signs EIP-3009 authorizations (from = treasury) with an agent node key",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./keystore": "./src/keystore.ts",
    "./adapters": "./src/adapters/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "golden": "tsx scripts/gen-golden.ts",
    "settle:live": "tsx scripts/settle-live.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@overflow/schemas": "workspace:*",
    "viem": "^2.57.10",
    "zod": "^4.6.7"
  }
}

# Serve typed fixtures instead of calling the service. Every page shows a MOCK badge while this is 1.
NEXT_PUBLIC_USE_MOCKS=1
# The Overflow service (apps/service). Used when NEXT_PUBLIC_USE_MOCKS is not 1.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Show the SCRIPTED badge in the top bar (demo runs with a scripted beat).
NEXT_PUBLIC_SCRIPTED=0

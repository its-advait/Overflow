# Copy to .env and fill in. Never commit real values.

# ---- Chain (Base Sepolia) ----
# HTTPS RPC endpoint for Base Sepolia
BASE_SEPOLIA_RPC_URL=
# Base Sepolia chain id
CHAIN_ID=84532
# USDC on Base Sepolia (6 decimals)
TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Contract addresses and deployBlock come from deployments/base-sepolia.json (written by the deploy
# script). Override its location here. Without the file and BASE_SEPOLIA_RPC_URL the indexer stays idle.
OVERFLOW_DEPLOYMENTS_PATH=
# Event indexer: poll interval (ms), blocks re-read each poll for reorgs, max blocks per eth_getLogs
# (public Base Sepolia RPC caps the range near 200).
INDEXER_POLL_MS=2000
INDEXER_REORG_DEPTH=12
INDEXER_CHUNK_BLOCKS=190

# ---- Keys (0x-prefixed hex private keys; test wallets only) ----
# Deploys OverflowTreasury / OverflowEscrow
DEPLOYER_PRIVATE_KEY=
# Submits settle()/reserve() transactions on behalf of the service
RELAYER_PRIVATE_KEY=
# Treasury owner / policy admin address
OWNER_ADDRESS=
# Root key agent keys are derived from
AGENT_ROOT_KEY=
# Comma-separated agent private keys
AGENT_KEYS=
# Comma-separated SIMULATED seller private keys
SELLER_KEYS=
# SIMULATED "state registry feed" that signs every dataset record (data/, pnpm datasets:generate).
# Empty = the label-derived simulated key the committed data uses; a custom key changes every file.
SOURCE_SIGNER_KEY=
# SIMULATED attacker address used in the demo
ATTACKER_ADDRESS=

# ---- Model provider (Anthropic is the only provider) ----
ANTHROPIC_API_KEY=
# Model id read by the service; never hardcoded in code
CLAUDE_MODEL=

# ---- Coinbase Developer Platform (x402 facilitator) ----
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ---- Storage ----
# postgres://user:pass@host:5432/overflow
DATABASE_URL=
# Used only when DATABASE_URL is empty: PGlite (in-process Postgres) data directory.
# Leave empty or ":memory:" for an in-memory database (tests do this).
PGLITE_DATA_DIR=
# Name of the FICTIONAL demo company the seed creates (default: Larkspur Research Partners)
COMPANY_NAME=
# Organization the demo session is scoped to (default: the seeded "org-demo")
OVERFLOW_ORG_ID=
# Folder holding the Drizzle SQL migrations. Default when empty: packages/database/drizzle
# (resolved next to the package source). The built service ships a copy in
# apps/service/dist/drizzle and its `pnpm start` script sets this to dist/drizzle.
OVERFLOW_MIGRATIONS_DIR=

# ---- Service URLs ----
# e.g. http://localhost:4000
SERVICE_URL=
# e.g. http://localhost:4100 (SIMULATED sellers)
SELLER_URL=

# ---- Misc ----
# Contract verification on Basescan
BASESCAN_API_KEY=
# "true" enables simulated flows; every simulated element is labeled in the UI
DEMO_MODE=

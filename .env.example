# Copy to .env and fill in. Never commit real values.

# ---- Chain (Base Sepolia) ----
# HTTPS RPC endpoint for Base Sepolia
BASE_SEPOLIA_RPC_URL=
# Base Sepolia chain id
CHAIN_ID=84532
# USDC on Base Sepolia (6 decimals)
TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Contract addresses and deployBlock come from deployments/base-sepolia.json (written by the deploy
# script). Override its location here. Without the file and BASE_SEPOLIA_RPC_URL the indexer stays idle.
OVERFLOW_DEPLOYMENTS_PATH=
# Event indexer: poll interval (ms), blocks re-read each poll for reorgs, max blocks per eth_getLogs
# (public Base Sepolia RPC caps the range near 200).
INDEXER_POLL_MS=2000
INDEXER_REORG_DEPTH=12
INDEXER_CHUNK_BLOCKS=190

# ---- Keys (test wallets only) ----
# Each *_KEY slot holds either a 0x-prefixed 64-hex private key, or just the address when the key
# lives in a Foundry keystore (cast wallet import <name>). Deploys sign with the keystore below.
# Deploys OverflowTreasury / OverflowEscrow (address or key)
DEPLOYER_PRIVATE_KEY=
# Foundry keystore name holding the deployer key (cast wallet list)
DEPLOYER_ACCOUNT=overflow-deployer
# chmod-600 file containing that keystore's password; required by pnpm contracts:deploy and pnpm dev:fund
DEPLOYER_PASSWORD_FILE=
# Deployer address (used for DRY_RUN simulation and dev:fund balance checks)
DEPLOYER_ADDRESS=
# Submits settle()/reserve() transactions on behalf of the service: holds gas ETH only, never USDC.
# Either a 64-hex key (dev), or the relayer's address with the key in the keystore below.
RELAYER_PRIVATE_KEY=
# Foundry keystore name for the relayer (cast wallet import overflow-relayer); the service decrypts it in memory
RELAYER_ACCOUNT=overflow-relayer
# chmod-600 file holding that keystore's password
RELAYER_PASSWORD_FILE=
# Treasury owner / policy admin: the controller's Coinbase smart wallet (from Wallet MCP get_wallets). With
# owner != deployer, Deploy.s.sol prints the setEscrowFactory/createRoot calldata for the controller's send_calls.
OWNER_ADDRESS=
# Root key agent keys are derived from (address or key)
AGENT_ROOT_KEY=
# Foundry keystore for the root agent key, used by pnpm demo:facilitator to sign authorizations
AGENT_ROOT_ACCOUNT=overflow-agent-root
AGENT_ROOT_PASSWORD_FILE=
# Root node key address passed to createRoot (defaults to AGENT_ROOT_KEY when that is an address).
# For a CDP-held root (no raw agent key anywhere) set it to the CDP server account's address, printed by
# `pnpm --filter @overflow/payment-client cdp:sign-check`.
AGENT_ROOT_ADDRESS=
# Comma-separated sub-agent private keys in role order: research, finance, verification (the mission runner
# has the orchestrator sign CreateChild for each). DEMO LIMITATION: keys live in env; P7.4 may move them to
# CDP server wallets. Each key may own at most one treasury node; a paused/expired node needs a fresh key.
AGENT_KEYS=
# overflow-mcp (packages/overflow-mcp): the node key the MCP server signs x402 payments with (from = treasury).
# 0x 64-hex key, or just the address when NODE_ACCOUNT names a Foundry keystore (NODE_PASSWORD_FILE chmod 600).
NODE_PRIVATE_KEY=
NODE_ACCOUNT=
NODE_PASSWORD_FILE=
# Where the node key lives: env (default: NODE_PRIVATE_KEY or the keystore above) or cdp (a Coinbase Developer
# Platform EVM server account; the key never leaves CDP). cdp needs the CDP_* credentials below plus CDP_ACCOUNT_NAME.
NODE_SIGNER=env
# CDP server account that holds the node key (2-36 alphanumerics/hyphens; looked up by name, never auto-created).
CDP_ACCOUNT_NAME=
# Optional pin: refuse to start if that account's address differs.
CDP_ACCOUNT_ADDRESS=
# Optional pin: the MCP server refuses to start if the service's /health reports another treasury.
TREASURY=
# Optional mission-runner overrides: payees a role's child node may pay (comma addresses) and budget shares
# in basis points (defaults research 4000 [search+scrape payees], finance 4000 [none], verification 2000 [search]).
ORCHESTRATION_PAYEES_RESEARCH=
ORCHESTRATION_PAYEES_FINANCE=
ORCHESTRATION_PAYEES_VERIFICATION=
ORCHESTRATION_BPS_RESEARCH=
ORCHESTRATION_BPS_FINANCE=
ORCHESTRATION_BPS_VERIFICATION=
# Comma-separated SIMULATED seller private keys
SELLER_KEYS=
# SIMULATED "state registry feed" that signs every dataset record (data/, pnpm datasets:generate).
# Empty = the label-derived simulated key the committed data uses; a custom key changes every file.
SOURCE_SIGNER_KEY=
# SIMULATED attacker payee for the sellers' /premium-intel fixture. NEVER allowlist it on the treasury;
# the demo expects PayeeNotAllowed(0). Unset = the fixture answers 503.
ATTACKER_ADDRESS=
# Payee the deploy script allowlists for the facilitator demo (pnpm demo:facilitator pays it)
DEMO_PAYEE_ADDRESS=
# SIMULATED direct-API payees (/api/search 0.02 USDC, /api/scrape 0.05 USDC). The owner must setAllow()
# them for payments to settle. Unset = derived from SELLER_KEYS[0]/[1], else label-derived simulated defaults.
PAYEE_SEARCH_ADDRESS=
PAYEE_SCRAPE_ADDRESS=

# ---- Model provider (Anthropic is the only provider) ----
ANTHROPIC_API_KEY=
# Model id read by the service; never hardcoded in code
CLAUDE_MODEL=

# Optional real search provider for the sellers' /api/search and /api/scrape (Context.dev).
# Unset = labeled CANNED results.
CONTEXT_DEV_API_KEY=

# ---- Coinbase Developer Platform (x402 facilitator + server accounts) ----
# Secret API key (portal.cdp.coinbase.com). Read by the CDP SDK itself; Overflow checks presence by name only.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Wallet Secret (portal: Server Wallets > Wallet Secret). Required for any CDP signing (NODE_SIGNER=cdp, cdp:sign-check).
CDP_WALLET_SECRET=
# The CDP SDK reports usage and errors to Coinbase unless disabled. Overflow's scripts set these when unset.
DISABLE_CDP_USAGE_TRACKING=true
DISABLE_CDP_ERROR_REPORTING=true

# ---- Storage ----
# postgres://user:pass@host:5432/overflow
DATABASE_URL=
# Used only when DATABASE_URL is empty: PGlite (in-process Postgres) data directory.
# Leave empty or ":memory:" for an in-memory database (tests do this).
PGLITE_DATA_DIR=
# Name of the FICTIONAL demo company the seed creates (default: Larkspur Research Partners)
COMPANY_NAME=
# Organization the demo session is scoped to (default: the seeded "org-demo")
OVERFLOW_ORG_ID=
# Folder holding the Drizzle SQL migrations. Default when empty: packages/database/drizzle
# (resolved next to the package source). The built service ships a copy in
# apps/service/dist/drizzle and its `pnpm start` script sets this to dist/drizzle.
OVERFLOW_MIGRATIONS_DIR=

# ---- Service URLs ----
# e.g. http://localhost:4000
SERVICE_URL=
# Same URL for the Next.js UI (apps/web /controller polls /api/controller-requests). Default http://localhost:4000
NEXT_PUBLIC_SERVICE_URL=
# SIMULATED sellers (served by the service process on this URL's port). Default http://localhost:4100
SELLER_URL=

# ---- Deploy parameters (pnpm contracts:deploy) ----
# Root node budget in atomic USDC (default 50000000 = 50 USDC), per-call limit (default 15000000),
# expiry as unix seconds (default now + 7 days). DRY_RUN=1 simulates without broadcasting.
ROOT_CAP=
ROOT_MAX_PER_CALL=
ROOT_EXPIRY=
DRY_RUN=

# ---- Misc ----
# Contract verification on Basescan
BASESCAN_API_KEY=
# "true" enables simulated flows; every simulated element is labeled in the UI. Also required for the
# sellers to honor x-overflow-force-broadcast (broadcast a settle() the simulation says will revert, so
# the prompt-injection demo lands its PayeeNotAllowed revert on Basescan).
DEMO_MODE=
# Shared secret for the demo-only facilitator routes (x-demo-token header); required when DEMO_MODE=true
DEMO_TOKEN=
# Facilitator /events chain-log poll interval in ms (default 4000)
EVENTS_POLL_MS=

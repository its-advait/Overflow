pragma solidity 0.8.28;

import {Test} from "forge-std/Test.sol";

/// @notice Golden vector shared with the TypeScript payment client (packages/payment-client: src/golden.ts, test/golden.json).
/// Recomputes the EIP-3009 TransferWithAuthorization digest the treasury's settle()/reserve()
/// must rebuild (from = the treasury, USDC domain) and checks it against the TypeScript client.
/// The fixture at test/fixtures/payment-client-golden.json is generated by
/// the package's `golden` script (pnpm --filter ...payment-client golden). Inputs are fixed; drift on either side fails.
contract PaymentClientGoldenTest is Test {
    address constant USDC = 0x036CbD53842c5426634e7929541eC2318f3dCF7e;
    bytes32 constant USDC_DOMAIN_SEPARATOR = 0x71f17a3b2ff373b803d70a5a07c046c1a2bc8e89c09ef722fcb047abe94c9818;
    uint256 constant CHAIN_ID = 84532;
    bytes32 constant TWA_TYPEHASH = 0x7c7c6cdb67a18743f49ec6fa9b35f50d52ed05cbed4cc592e13b44501c1a2267;

    address constant TREASURY = 0x1111111111111111111111111111111111111111;
    address constant TO = 0x2222222222222222222222222222222222222222;
    uint256 constant VALUE = 20000;
    uint256 constant VALID_AFTER = 1791700000;
    uint256 constant VALID_BEFORE = 1791700120;

    // Pinned on both sides (packages/payment-client/src/golden.test.ts EXPECTED_DIGEST).
    bytes32 constant EXPECTED_DIGEST = 0xb2d39a5bf926c7a6e8c9447445a9b38006b415db638e540792757a03b40e2dc8;

    string constant FIXTURE = "test/fixtures/payment-client-golden.json";

    function _nonce() internal pure returns (bytes32) {
        return keccak256("overflow.golden.nonce");
    }

    /// TEST ONLY, publicly derived; never fund it.
    function _pk() internal pure returns (uint256) {
        return uint256(keccak256("overflow.golden.key"));
    }

    function _digest() internal pure returns (bytes32 structHash, bytes32 digest) {
        structHash = keccak256(abi.encode(TWA_TYPEHASH, TREASURY, TO, VALUE, VALID_AFTER, VALID_BEFORE, _nonce()));
        digest = keccak256(abi.encodePacked("\x19\x01", USDC_DOMAIN_SEPARATOR, structHash));
    }

    function test_typehash_and_domain() public pure {
        assertEq(
            keccak256(
                "TransferWithAuthorization(address from,address to,uint256 value,uint256 validAfter,uint256 validBefore,bytes32 nonce)"
            ),
            TWA_TYPEHASH,
            "typehash"
        );
        bytes32 sep = keccak256(
            abi.encode(
                keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)"),
                keccak256("USDC"),
                keccak256("2"),
                CHAIN_ID,
                USDC
            )
        );
        assertEq(sep, USDC_DOMAIN_SEPARATOR, "USDC domain separator");
    }

    function test_digest_matches_pinned_constant() public pure {
        (, bytes32 digest) = _digest();
        assertEq(digest, EXPECTED_DIGEST, "twa digest");
    }

    function test_digest_and_signature_match_typescript_fixture() public view {
        string memory json = vm.readFile(FIXTURE);

        assertEq(vm.parseJsonUint(json, ".chainId"), CHAIN_ID, "chainId");
        assertEq(vm.parseJsonAddress(json, ".usdc"), USDC, "usdc");
        assertEq(vm.parseJsonBytes32(json, ".domainSeparator"), USDC_DOMAIN_SEPARATOR, "domainSeparator");
        assertEq(vm.parseJsonBytes32(json, ".typehash"), TWA_TYPEHASH, "typehash");
        assertEq(vm.parseJsonAddress(json, ".authorization.from"), TREASURY, "from");
        assertEq(vm.parseJsonAddress(json, ".authorization.to"), TO, "to");
        assertEq(vm.parseJsonUint(json, ".authorization.value"), VALUE, "value");
        assertEq(vm.parseJsonUint(json, ".authorization.validAfter"), VALID_AFTER, "validAfter");
        assertEq(vm.parseJsonUint(json, ".authorization.validBefore"), VALID_BEFORE, "validBefore");
        assertEq(vm.parseJsonBytes32(json, ".authorization.nonce"), _nonce(), "nonce");

        (bytes32 structHash, bytes32 digest) = _digest();
        assertEq(structHash, vm.parseJsonBytes32(json, ".structHash"), "structHash");
        assertEq(digest, vm.parseJsonBytes32(json, ".digest"), "digest");
        assertEq(digest, EXPECTED_DIGEST, "pinned digest");

        // Same key, same digest: RFC 6979 makes viem's and Foundry's signatures identical.
        uint256 pk = _pk();
        assertEq(bytes32(pk), vm.parseJsonBytes32(json, ".testOnlyPrivateKey"), "test key");
        address signer = vm.addr(pk);
        assertEq(signer, vm.parseJsonAddress(json, ".signer"), "signer");
        assertTrue(signer != TREASURY, "signer is a node key, not the treasury");

        (uint8 v, bytes32 r, bytes32 s) = vm.sign(pk, digest);
        bytes memory sig = abi.encodePacked(r, s, v);
        assertEq(sig, vm.parseJsonBytes(json, ".signature"), "signature");
        assertEq(ecrecover(digest, v, r, s), signer, "ecrecover");
    }
}

{
  "name": "overflow",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @overflow/web --filter @overflow/service dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "vitest run",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:fork": "bash scripts/fork-test.sh",
    "contracts:gas": "pnpm --filter @overflow/scripts gas",
    "contracts:invariant": "forge test --root contracts --match-path 'test/invariant/*'",
    "contracts:deploy": "bash scripts/deploy.sh",
    "contracts:export": "pnpm --filter @overflow/scripts export",
    "demo:adapters": "pnpm --filter @overflow/scripts demo-adapters",
    "demo:facilitator": "pnpm --filter @overflow/scripts demo-facilitator",
    "service": "pnpm --filter @overflow/service dev",
    "spike:seller": "pnpm --filter @overflow/service spike:seller",
    "spike:coinbase": "pnpm --filter @overflow/scripts coinbase-spike",
    "status": "pnpm --filter @overflow/scripts status",
    "dev:fund": "pnpm --filter @overflow/scripts dev-fund"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
